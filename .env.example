# Copy to .env.local for local testing with a real Neon database.
# Without DATABASE_URL the app uses a local JSON file store (data/chronolyte.json).

# Neon Postgres connection string (required in production on Vercel)
DATABASE_URL=

# Canonical site origin used for SEO tags, sitemap, and llms.txt
SITE_URL=https://chronolyte.com

# Seeded as the first admin account on first launch
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@chronolyte.com
