{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**": {
      "includeFiles": "dist/index.html",
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/guides", "destination": "/blog", "permanent": true },
    { "source": "/guides/:slug", "destination": "/blog/:slug", "permanent": true },
    { "source": "/fiverr-upwork-alternative", "destination": "/blog/fiverr-upwork-alternative", "permanent": true },
    { "source": "/fiverr-upwork-alternative/", "destination": "/blog/fiverr-upwork-alternative", "permanent": true },
    { "source": "/services/:slug", "destination": "/services", "permanent": false },
    { "source": "/start", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api", "destination": "/api/handler" },
    { "source": "/api/:__orig(.*)", "destination": "/api/handler" },
    { "source": "/backend/api/:__orig(.*)", "destination": "/api/handler" },
    { "source": "/uploads/:__orig(.*)", "destination": "/api/handler?__ns=files" },
    { "source": "/blog", "destination": "/api/handler?__ns=page/blog" },
    { "source": "/blog/:__orig([^/]+)", "destination": "/api/handler?__ns=page/blog" },
    { "source": "/((?!api/|uploads/|assets/|favicon\\.svg|favicon\\.ico|og-image\\.png|robots\\.txt|sitemap\\.xml|llms\\.txt|site\\.webmanifest|browserconfig\\.xml).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
