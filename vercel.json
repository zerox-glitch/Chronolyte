{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**": {
      "includeFiles": "dist/index.html",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/backend/api/(.*)", "destination": "/api/$1" },
    { "source": "/uploads/(.*)", "destination": "/api/files/$1" },
    { "source": "/blog/:slug", "destination": "/api/page/blog/:slug" },
    { "source": "/blog", "destination": "/api/page/blog" },
    { "source": "/((?!api/|uploads/|assets/|favicon\\.svg|favicon\\.ico|og-image\\.png|robots\\.txt|sitemap\\.xml|llms\\.txt|site\\.webmanifest|browserconfig\\.xml).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
